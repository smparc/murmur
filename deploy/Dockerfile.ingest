# Ingestion: Kafka -> GPU mel-spectrogram -> windowed republish.
#
# Built on the PyTorch CUDA image rather than a bare nvidia/cuda base. The
# previous Dockerfile installed torch from PyPI on top of nvidia/cuda, which
# resolves to the CPU-only wheel — so the "GPU-accelerated" container silently
# ran every spectrogram on the CPU.

FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# librdkafka is required by confluent-kafka's wheel at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        librdkafka1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layer first: source changes then do not invalidate the (slow)
# dependency install.
COPY pyproject.toml README.md ./
COPY src/__init__.py ./src/__init__.py
RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        "." \
    && pip uninstall -y murmur

COPY src/ ./src/

RUN pip install --no-cache-dir --no-deps .

# Non-root: a container that processes untrusted network input should not be
# able to write to its own image.
RUN useradd --create-home --uid 10001 murmur \
    && chown -R murmur:murmur /app
USER murmur

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import torch, confluent_kafka" || exit 1

ENTRYPOINT ["murmur-ingest"]
